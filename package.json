    "lucide-react": "^1.77.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^1.0.0-beta.22",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.2",
